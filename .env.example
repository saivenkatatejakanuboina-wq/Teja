FLASK_APP=wsgi:app
# development | production
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///instance/crm.db

# Default Admin account (created automatically on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@minicrm.local
# Use a strong password in production (required when FLASK_ENV=production)
ADMIN_PASSWORD=admin123

# Feature flags
SEED_DEMO_USERS=true
ALLOW_PUBLIC_REGISTRATION=true

# Store emails in history without calling SMTP (demo/testing)
MAIL_SUPPRESS_SEND=false

# SMTP is configured in the app under Settings → SMTP
# WhatsApp provider settings live under WhatsApp → Settings

# Production process
# HOST=0.0.0.0
# PORT=8000
# WEB_CONCURRENCY=2
